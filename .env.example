# Copy to .env and fill, OR export these in your shell before running.
# Source of truth is Google Secret Manager (project agent-era); these are the
# runtime injection point (locally an export, on Cloud Run a secret-backed env).

# Fivetran credentials — pull from Secret Manager:
#   export FIVETRAN_API_KEY=$(gcloud secrets versions access latest --secret=FIVETRAN_API_KEY --project=agent-era)
#   export FIVETRAN_API_SECRET=$(gcloud secrets versions access latest --secret=FIVETRAN_API_SECRET --project=agent-era)
FIVETRAN_API_KEY=
FIVETRAN_API_SECRET=

# Gemini / Vertex AI. Auth via the runtime SA key (local) or attached SA (Cloud Run):
#   export GOOGLE_APPLICATION_CREDENTIALS=.secrets/dq-sentinel-runtime.json
# NOTE: Gemini 3.x models are served from the `global` Vertex location, NOT a
# regional one — using us-central1 gives a 403 "or it may not exist".
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=agent-era
GOOGLE_CLOUD_LOCATION=global

# Optional overrides (defaults in dq_sentinel/config.py):
# GEMINI_MODEL_ID=gemini-3.5-flash
